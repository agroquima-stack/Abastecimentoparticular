# Copie este arquivo para .env.local (nunca comitar o .env.local — já está no .gitignore)
# e preencha com os valores do seu projeto Firebase: console.firebase.google.com
# > Configurações do projeto > Geral > Seus apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
