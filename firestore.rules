rules_version = '2';

// Todos os dados (veículos, semanas, lançamentos, parâmetros) exigem login — sem cadastro pelo
// app, contas só criadas manualmente em Firebase Console > Authentication > Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
